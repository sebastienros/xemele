// --control disables every allocation/retention counter and timer.
using System.Runtime.InteropServices;
using System.Security.Cryptography;
using System.Text;
using System.Text.Json;
using Xemele.Validation;
using Xemele.Benchmarks.M8XsdIdentity;
if (args is not [var mode, var output] || mode is not ("--control" or "--measure")) throw new ArgumentException("Use --control|--measure output.");
if (RuntimeInformation.FrameworkDescription != ".NET 10.0.11") throw new InvalidOperationException("Pinned runtime required.");
bool measure = mode == "--measure";
long coldBefore = measure ? GC.GetAllocatedBytesForCurrentThread() : 0;
var fixture = new IdentityFixture();
long coldSetupBytes = measure ? GC.GetAllocatedBytesForCurrentThread() - coldBefore : 0;
var rows = new List<object>();
long? positiveBytes = null, retainedBefore = null, retainedAfterPrograms = null, retainedAfterSessions = null;
int? retainedPrograms = null, retainedSessions = null;
for (int route = 0; route < IdentityFixture.Routes.Length; route++)
{
    for (int warm = 0; warm < 32; warm++) fixture.Run(route);
    var distribution = new long[64];
    long before = measure ? GC.GetAllocatedBytesForCurrentThread() : 0;
    for (int i = 0; i < distribution.Length; i++)
    {
        long start = measure ? GC.GetAllocatedBytesForCurrentThread() : 0;
        fixture.Run(route); distribution[i] = measure ? GC.GetAllocatedBytesForCurrentThread() - start : 0;
    }
    long bytes = measure ? GC.GetAllocatedBytesForCurrentThread() - before : 0;
    rows.Add(new { route, name = IdentityFixture.Routes[route], operations = 64, bytes, distribution });
    if (measure && (route < 5 ? bytes != 0 || distribution.Any(b => b != 0) : bytes <= 0 || distribution.Any(b => b <= 0)))
    {
        string failure = "Allocation ownership control failed: " + IdentityFixture.Routes[route];
        WriteResult("failed", failure, route); // Save every completed distribution before failing.
        throw new InvalidOperationException(failure);
    }
}
long positiveBefore = measure ? GC.GetAllocatedBytesForCurrentThread() : 0;
var positive = new byte[1024]; GC.KeepAlive(positive);
positiveBytes = measure ? GC.GetAllocatedBytesForCurrentThread() - positiveBefore : 0;
if (measure && positiveBytes.Value < 1024)
{
    WriteResult("failed", "Positive allocation control failed.", null);
    throw new InvalidOperationException("Positive allocation control failed.");
}
retainedBefore = measure ? GC.GetTotalMemory(true) : 0;
var retained = new XsdIdentityProgram[32]; for (int i = 0; i < retained.Length; i++) retained[i] = fixture.NewProgram();
retainedPrograms = retained.Length; retainedAfterPrograms = measure ? GC.GetTotalMemory(true) : 0;
var cursors = new IXsdIdentitySession[32]; for (int i = 0; i < cursors.Length; i++) cursors[i] = fixture.NewInitializedSession();
retainedSessions = cursors.Length; retainedAfterSessions = measure ? GC.GetTotalMemory(true) : 0;
GC.KeepAlive(retained); GC.KeepAlive(cursors); GC.KeepAlive(fixture);
WriteResult("passed", null, null);
Console.WriteLine($"{mode}: {IdentityFixture.Routes.Length} consumed routes, 32 warm + 64 operations each; counters {(measure ? "enabled" : "disabled")}");
void WriteResult(string status, string? failure, int? failedRoute)
{
File.WriteAllText(output, JsonSerializer.Serialize(new { mode, status, failure, failedRoute, runtime = RuntimeInformation.FrameworkDescription,
    architecture = RuntimeInformation.ProcessArchitecture.ToString(), os = RuntimeInformation.OSDescription,
    serverGc = System.Runtime.GCSettings.IsServerGC, sourceRevision = Environment.GetEnvironmentVariable("XEMELE_IDENTITY_REVISION"),
    assemblySha256 = Hash(typeof(SchemaCompileOptions).Assembly.Location), probeSha256 = Hash(typeof(IdentityFixture).Assembly.Location),
    inputSha256 = HashText(IdentityFixture.Source), longInstanceSha256 = HashText(IdentityFixture.LongInstance), invalidSha256 = HashText(IdentityFixture.Invalid), instanceSha256 = HashText(IdentityFixture.Instance),
    coldSetupBytes, positiveBytes, retainedBefore, retainedAfterPrograms, retainedAfterSessions, retainedPrograms,
    retainedSessions, consumed = fixture.Consume(), rows }, new JsonSerializerOptions { WriteIndented = true }));
}
static string Hash(string path) => Convert.ToHexString(SHA256.HashData(File.ReadAllBytes(path)));
static string HashText(string value) => Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(value)));
