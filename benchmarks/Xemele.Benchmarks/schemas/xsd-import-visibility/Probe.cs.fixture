// --control performs the identical bounded routes with all allocation/heap counters disabled.
// Run --measure on an otherwise idle host.
using System.Runtime.InteropServices;
using System.Security.Cryptography;
using System.Text.Json;
using Xemele.Validation;
using Xemele.Benchmarks.M8XsdImportVisibility;
if (args is not [var mode, var output] || mode is not ("--control" or "--measure")) throw new ArgumentException("--control|--measure output.json");
bool measure = mode == "--measure";
long coldBefore = measure ? GC.GetAllocatedBytesForCurrentThread() : 0;
var fixture = new ImportFixture();
long coldInputsBytes = measure ? GC.GetAllocatedBytesForCurrentThread() - coldBefore : 0;
var rows = new List<object>();
for (int route = 0; route < ImportFixture.Routes.Length; route++)
{
    long firstBefore = measure ? GC.GetAllocatedBytesForCurrentThread() : 0;
    GC.KeepAlive(fixture.Run(route));
    long firstRunBytes = measure ? GC.GetAllocatedBytesForCurrentThread() - firstBefore : 0;
    for (int i = 0; i < 8; i++) GC.KeepAlive(fixture.Run(route));
    var distribution = new long[32];
    long before = measure ? GC.GetAllocatedBytesForCurrentThread() : 0;
    for (int i = 0; i < distribution.Length; i++)
    {
        long start = measure ? GC.GetAllocatedBytesForCurrentThread() : 0;
        GC.KeepAlive(fixture.Run(route));
        distribution[i] = measure ? GC.GetAllocatedBytesForCurrentThread() - start : 0;
    }
    long bytes = measure ? GC.GetAllocatedBytesForCurrentThread() - before : 0;
    if (measure && (bytes <= 0 || distribution.Any(b => b <= 0))) throw new InvalidOperationException("Expected owned-result allocation.");
    rows.Add(new { route, name = ImportFixture.Routes[route], operations = 32, firstRunBytes, bytes, distribution });
}
long positiveBefore = measure ? GC.GetAllocatedBytesForCurrentThread() : 0;
var positive = new byte[1024]; GC.KeepAlive(positive);
long positiveBytes = measure ? GC.GetAllocatedBytesForCurrentThread() - positiveBefore : 0;
if (measure && positiveBytes < 1024) throw new InvalidOperationException("Positive allocation control failed.");
int[][] retainedRoutes = [[4, 5, 7, 10], [2, 3, 2, 3], [0, 1, 6, 8], [9, 11, 12, 13], [19, 20, 21, 19], [14, 15, 16, 17], [18, 22, 23, 23]];
string[] retainedNames = ["compiled-graphs", "public-schemas", "unauthorized-diagnostics", "missing-limit-denied-cancelled", "annotation-valid-graphs", "annotation-invalid-diagnostics", "annotation-failure-results"];
var retained = new object[7][]; var heap = new List<object>();
for (int category = 0; category < retainedRoutes.Length; category++)
{
    long before = measure ? GC.GetTotalMemory(true) : 0;
    retained[category] = new object[4];
    for (int i = 0; i < 4; i++) retained[category][i] = fixture.Run(retainedRoutes[category][i]);
    long after = measure ? GC.GetTotalMemory(true) : 0;
    heap.Add(new { name = retainedNames[category], count = 4, before, after, delta = after - before });
}
GC.KeepAlive(retained); GC.KeepAlive(fixture);
File.WriteAllText(output, JsonSerializer.Serialize(new { mode, status = "passed", runtime = RuntimeInformation.FrameworkDescription,
    architecture = RuntimeInformation.ProcessArchitecture.ToString(), os = RuntimeInformation.OSDescription, serverGc = System.Runtime.GCSettings.IsServerGC,
    sourceRevision = Environment.GetEnvironmentVariable("XEMELE_IMPORT_REVISION"), assemblySha256 = Hash(typeof(XmlSchema).Assembly.Location), probeSha256 = Hash(typeof(ImportFixture).Assembly.Location),
    coldInputsBytes, positiveBytes, retainedResults = 28, heap, consumed = fixture.Consume(), rows }, new JsonSerializerOptions { WriteIndented = true }));
Console.WriteLine($"{mode}: 24 routes consumed; counters {(measure ? "enabled" : "disabled")}");
static string Hash(string path) => Convert.ToHexStringLower(SHA256.HashData(File.ReadAllBytes(path)));
