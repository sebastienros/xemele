// --control disables every allocation/retention counter and timer.
using System.Runtime.InteropServices;
using System.Security.Cryptography;
using System.Text;
using System.Text.Json;
using Xemele.Validation;
using Xemele.Benchmarks.M8XsdContent;
if (args is not [var mode, var output] || mode is not ("--control" or "--measure")) throw new ArgumentException("Use --control|--measure output.");
if (RuntimeInformation.FrameworkDescription != ".NET 10.0.11") throw new InvalidOperationException("Pinned runtime required.");
bool measure = mode == "--measure";
long coldBefore = measure ? GC.GetAllocatedBytesForCurrentThread() : 0;
var fixture = new ContentFixture();
long coldSetupBytes = measure ? GC.GetAllocatedBytesForCurrentThread() - coldBefore : 0;
var rows = new List<object>();
for (int route = 0; route < ContentFixture.Routes.Length; route++)
{
    for (int warm = 0; warm < 32; warm++) fixture.Run(route);
    var distribution = new long[64];
    long before = measure ? GC.GetAllocatedBytesForCurrentThread() : 0;
    for (int i = 0; i < distribution.Length; i++)
    {
        long start = measure ? GC.GetAllocatedBytesForCurrentThread() : 0;
        fixture.Run(route); distribution[i] = measure ? GC.GetAllocatedBytesForCurrentThread() - start : 0;
    }
    long bytes = measure ? GC.GetAllocatedBytesForCurrentThread() - before : 0;
    if (measure && (route < 5 ? bytes != 0 || distribution.Any(b => b != 0) : bytes <= 0 || distribution.Any(b => b <= 0))) throw new InvalidOperationException("Allocation ownership control failed: " + ContentFixture.Routes[route]);
    rows.Add(new { route, name = ContentFixture.Routes[route], operations = 64, bytes, distribution });
}
long positiveBefore = measure ? GC.GetAllocatedBytesForCurrentThread() : 0;
var positive = new byte[1024]; GC.KeepAlive(positive);
long positiveBytes = measure ? GC.GetAllocatedBytesForCurrentThread() - positiveBefore : 0;
if (measure && positiveBytes < 1024) throw new InvalidOperationException("Positive allocation control failed.");
long retainedBefore = measure ? GC.GetTotalMemory(true) : 0;
var retained = new XsdContentProgram[32]; for (int i = 0; i < retained.Length; i++) retained[i] = fixture.NewProgram();
long retainedAfterPrograms = measure ? GC.GetTotalMemory(true) : 0;
var cursors = new IXsdContentCursor[32]; for (int i = 0; i < cursors.Length; i++) cursors[i] = fixture.NewInitializedCursor();
long retainedAfterCursors = measure ? GC.GetTotalMemory(true) : 0;
GC.KeepAlive(retained); GC.KeepAlive(cursors); GC.KeepAlive(fixture); int consumed = fixture.Consume();
File.WriteAllText(output, JsonSerializer.Serialize(new { mode, runtime = RuntimeInformation.FrameworkDescription,
    architecture = RuntimeInformation.ProcessArchitecture.ToString(), os = RuntimeInformation.OSDescription,
    serverGc = System.Runtime.GCSettings.IsServerGC, sourceRevision = Environment.GetEnvironmentVariable("XEMELE_CONTENT_REVISION"),
    assemblySha256 = Hash(typeof(SchemaCompileOptions).Assembly.Location), probeSha256 = Hash(typeof(ContentFixture).Assembly.Location),
    inputSha256 = HashText(ContentFixture.Source), invalidSha256 = HashText(ContentFixture.Invalid), instanceSha256 = HashText(ContentFixture.Instance),
    coldSetupBytes, positiveBytes, retainedBefore, retainedAfterPrograms, retainedAfterCursors, retainedPrograms = retained.Length,
    retainedCursors = cursors.Length, consumed, rows }, new JsonSerializerOptions { WriteIndented = true }));
Console.WriteLine($"{mode}: {ContentFixture.Routes.Length} consumed routes, 32 warm + 64 operations each; counters {(measure ? "enabled" : "disabled")}");
static string Hash(string path) => Convert.ToHexString(SHA256.HashData(File.ReadAllBytes(path)));
static string HashText(string value) => Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(value)));
