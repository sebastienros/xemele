
<grammar xmlns="http://relaxng.org/ns/structure/1.0">
  <start>
    <element name="foo">
      <empty/>
    </element>
  </start>
  <define name="bar">
    <grammar xmlns="http://relaxng.org/ns/structure/1.0">
      <start>
	<parentRef name="foo"/>
      </start>
      <define name="foo">
        <element name="foo">
          <empty/>
        </element>
      </define>
    </grammar>
  </define>
</grammar>
