using Xemele.XPath;
using Xemele.XPath.Internal;
internal sealed class Budget : IXPathBudget
{
    public long Operations;
    public CancellationToken CancellationToken => default;
    public void ChargeOperations(long amount) { if (amount < 0) throw new ArgumentOutOfRangeException(nameof(amount)); Operations = checked(Operations + amount); }
    public void CheckNodeSetSize(int count) { if (count > 2) throw new InvalidOperationException(); }
    public void CheckStringSize(int count) { if (count > 10) throw new InvalidOperationException(); }
}
internal sealed class NavigationProbe : IXPathNavigator
{
    public XPathItem Root => default;
    public IReadOnlyList<XPathItem> SelectAxis(XPathItem item, XPathAxis axis, IXPathBudget budget) { budget.ChargeOperations(1); return []; }
    public int CompareDocumentOrder(XPathItem left, XPathItem right, IXPathBudget budget) { budget.ChargeOperations(1); return 0; }
    public IReadOnlyList<XPathItem> SelectId(string id, IXPathBudget budget) { budget.ChargeOperations(1); return []; }
    public string? FindLanguage(XPathItem item, IXPathBudget budget) { budget.ChargeOperations(1); return "en-US"; }
}
internal static class Program
{
    public static void Main()
    {
        IXPathNavigator navigator = new NavigationProbe(); var budget = new Budget();
        foreach (var axis in Enum.GetValues<XPathAxis>()) if (navigator.SelectAxis(default, axis, budget).Count != 0) throw new Exception();
        _ = navigator.CompareDocumentOrder(default, default, budget); _ = navigator.SelectId("id", budget);
        if (navigator.FindLanguage(default, budget) != "en-US" || budget.Operations != 16) throw new Exception("navigation budget");
        Console.WriteLine("PASS: independent navigator seam, 13 axes + order/ID/language budget dispatch (fake navigation)");
    }
}
