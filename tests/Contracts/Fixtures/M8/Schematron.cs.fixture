using Xemele.XPath;
namespace Xemele.Validation;
internal sealed record SchematronLet(XPathExpandedName Name, XPathExpression Value);
internal abstract record SchematronTextPart;
internal sealed record SchematronLiteral(string Text) : SchematronTextPart;
internal sealed record SchematronValueOf(XPathExpression Select) : SchematronTextPart;
internal sealed record SchematronNameOf(XPathExpression? Path) : SchematronTextPart;
internal sealed record SchematronCompiledCheck(SchematronFindingKind Kind, string? Id, string? Role, string? Flag,
    string TestSource, XPathExpression Test, IReadOnlyList<SchematronTextPart> Text, IReadOnlyList<string> Diagnostics, IReadOnlyList<string> Properties, XmlLocation Location);
internal sealed record SchematronCompiledRule(string ContextSource, XPathExpression ContextSelector,
    IReadOnlyList<SchematronLet> Lets, IReadOnlyList<SchematronCompiledCheck> Checks, XmlLocation Location);
internal sealed record SchematronCompiledPattern(string Id, string? Name, IReadOnlyList<SchematronLet> Lets,
    IReadOnlyList<SchematronCompiledRule> Rules);
internal sealed record SchematronCompiledModel(string? Title, string DefaultPhase,
    IReadOnlyDictionary<string, string> Namespaces, IReadOnlyList<SchematronLet> Lets,
    IReadOnlyList<SchematronCompiledPattern> Patterns, IReadOnlyDictionary<string, IReadOnlyList<string>> Phases,
    IReadOnlyDictionary<string, IReadOnlyList<SchematronTextPart>> Diagnostics,
    IReadOnlyDictionary<string, IReadOnlyList<SchematronTextPart>> Properties);
internal interface ISchematronCompiler
{
    SchematronCompiledModel Compile(XmlDocument schema, SchematronCompileOptions options, ISchemaOperation operation);
}
internal interface ISchematronEvaluator
{
    SchematronResult Validate(SchematronCompiledModel schema, XmlDocument document, SchematronValidationOptions options);
}
public sealed class SchematronSchema
{
    private SchematronSchema() { }
    public static SchematronSchema Compile(XmlDocument schema, SchematronCompileOptions? options = null) => throw new InvalidOperationException("Declaration only");
    public static SchematronSchema Compile(string schema, SchematronCompileOptions? options = null) => throw new InvalidOperationException("Declaration only");
    public static SchematronSchema Compile(Stream schema, SchematronCompileOptions? options = null) => throw new InvalidOperationException("Declaration only");
    public SchematronResult Validate(XmlDocument document, SchematronValidationOptions? options = null) => throw new InvalidOperationException("Declaration only");
    public SchematronResult Validate(string document, SchematronValidationOptions? options = null) => throw new InvalidOperationException("Declaration only");
    public SchematronResult Validate(Stream document, SchematronValidationOptions? options = null) => throw new InvalidOperationException("Declaration only");
}
