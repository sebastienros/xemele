using Xemele;
using Xemele.Validation;
internal static class ReportingReviewConsumers
{
    internal static string DetachedOrder()
    {
        // Two unnamed patterns; first has no findings. Both fired at the same context.
        // Authored IDs stay null; explicit ordinal/event keys carry the association.
        var result = new SchematronResult(new ValidationResult(true, [new("SCH.Report",XmlDiagnosticSeverity.Warning,"found",default)]),
            "#ALL", null, new Dictionary<string,string>(), [new(0,null,null),new(1,null,null)],
            [new(0,0,0,"/root","/*[local-name()='root' and namespace-uri()=''][1]"),new(1,1,1,"/root","/*[local-name()='root' and namespace-uri()=''][1]")],
            [new(SchematronFindingKind.SuccessfulReport, null,null,null,1,1,null,"/root","true()",
                "/*[local-name()='root' and namespace-uri()=''][1]/*[local-name()='child' and namespace-uri()=''][1]",default,"/*[local-name()='root' and namespace-uri()=''][1]",default,"found",[],[])]);
        return SchematronReport.SerializeSvrl(result);
    }
}
