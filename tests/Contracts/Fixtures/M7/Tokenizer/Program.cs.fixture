using Xemele.Html;
static void Contract() { _=Html5Tokenizer.Tokenize("<br/>&amp;",new(){InitialState=HtmlTokenizerState.Data}); Html5Tokenizer.Tokenize("<p>x", token => { _=token.Location; _=token.SelfClosing; _=token.Attributes; }); }
// Signature consumer is compiled but deliberately never invokes declaration stubs.
Action contract = Contract; GC.KeepAlive(contract);
var xml = new Xemele.XmlDocument(); var root = xml.CreateElement("root"); xml.DocumentNode.AppendChild(root); root.AppendChild(xml.CreateText("preserved"));
if (root.GetTextContent() != "preserved") throw new Exception("XML tree changed");
using var reader = Xemele.Streaming.XmlReader.Create(new MemoryStream(System.Text.Encoding.UTF8.GetBytes("<root>preserved</root>"))); int count=0; while(reader.Read()) count++; if(count<3) throw new Exception("XML streaming changed");
Console.WriteLine("PASS: independent Tokenizer signatures; actual XML tree and streaming preservation; runtime " + Environment.Version);
