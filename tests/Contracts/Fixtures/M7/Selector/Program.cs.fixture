using Xemele;
using Xemele.Html;
using Xemele.Css;

static void HtmlContract()
{
    var doc = new HtmlDocument();
    var p = doc.CreateElement("p");
    p.SetAttribute(new("class", "a"));
    var defaultCss = new CssSelector();
    _ = defaultCss.Matches(p);
    _ = defaultCss.Select(doc.DocumentNode);
    var css = CssSelector.Compile("p.a:not([hidden]):nth-child(2n+1)");
    bool matches = css.Matches(p);
    IReadOnlyList<HtmlNode> selected = css.Select(doc.DocumentNode);
    _ = matches; _ = selected;
}
static void XmlContract()
{
    var doc = new XmlDocument();
    var root = doc.CreateElement("Root", "urn:sample", "x");
    doc.DocumentNode.AppendChild(root);
    root.SetAttribute("Class", "a");
    var options = new CssSelectorOptions { Namespaces = new Dictionary<string, string> { ["x"] = "urn:sample", [""] = "urn:sample" } };
    var css = CssSelector.Compile("x|Root[Class]:scope", options);
    bool matches = css.Matches(root);
    IReadOnlyList<XmlNode> selected = css.Select(doc.DocumentNode);
    _ = css.Matches(default(XmlNode));
    _ = css.Matches(doc.CreateText("text"));
    _ = css.Select(root);
    _ = css.Select(doc.CreateFragment());
    _ = matches; _ = selected;
}
// Signature consumers are compiled but deliberately never invoke declaration stubs.
Action htmlContract = HtmlContract, xmlContract = XmlContract;
GC.KeepAlive(htmlContract); GC.KeepAlive(xmlContract);
var xml = new XmlDocument();
var root = xml.CreateElement("Root", "http://www.w3.org/1999/xhtml");
xml.DocumentNode.AppendChild(root);
root.SetAttribute("Class", "A"); root.SetAttribute("class", "a");
root.AppendChild(xml.CreateText("preserved"));
if (root.LocalName != "Root" || root.GetAttribute("Class") != "A" || root.GetAttribute("class") != "a" || root.GetTextContent() != "preserved") throw new Exception("XML tree changed");
var detached = xml.CreateElement("Detached");
if (!detached.Parent.IsDefault || !default(XmlNode).IsDefault) throw new Exception("XML handle contract changed");
using var reader = Xemele.Streaming.XmlReader.Create(new MemoryStream(System.Text.Encoding.UTF8.GetBytes("<root>preserved</root>")));
int count = 0; while (reader.Read()) count++;
if (count < 3) throw new Exception("XML streaming changed");
Console.WriteLine("PASS: independent XML and HTML Selector signatures; actual XML tree and streaming preservation; runtime " + Environment.Version);
