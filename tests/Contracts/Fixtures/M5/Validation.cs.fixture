// Nonpackaged declaration contract, not shipping validation behavior.
namespace Xemele.Validation;
public sealed record ValidationResult
{
    public bool IsComplete { get; }
    public bool IsValid { get; }
    public IReadOnlyList<XmlDiagnostic> Diagnostics { get; }
    public ValidationResult(bool isComplete, IEnumerable<XmlDiagnostic> diagnostics)
    {
        ArgumentNullException.ThrowIfNull(diagnostics);
        var snapshot = diagnostics.ToArray();
        if (snapshot.Any(x => x is null)) throw new ArgumentException("Null diagnostic.", nameof(diagnostics));
        IsComplete = isComplete;
        IsValid = isComplete && !snapshot.Any(x => x.Severity is XmlDiagnosticSeverity.Error or XmlDiagnosticSeverity.Fatal);
        if (!isComplete && !snapshot.Any(x => x.Severity == XmlDiagnosticSeverity.Fatal))
            throw new ArgumentException("Incomplete results require a fatal diagnostic.", nameof(diagnostics));
        Diagnostics = Array.AsReadOnly(snapshot);
    }
}
public sealed record ValidationOptions
{
    public XmlResourceLimits Limits { get; init; } = new();
    public long? MaxOperations { get; init; } = 10_000_000;
    public CancellationToken CancellationToken { get; init; }
}
