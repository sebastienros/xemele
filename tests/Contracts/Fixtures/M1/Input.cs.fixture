namespace Xemele.Parsing.Input;
internal enum XmlInputEncoding { Undetermined, Utf8, Utf16LittleEndian, Utf16BigEndian }
internal enum DecodeStep { NeedInput, NeedOutput, Completed, InvalidInput }
internal readonly record struct DecodeResult(int ConsumedBytes, int WrittenCharacters, DecodeStep Step, Xemele.XmlDiagnostic? Diagnostic);
internal interface IXmlInputDecoder : IDisposable
{
    XmlInputEncoding Encoding { get; }
    DecodeResult Decode(ReadOnlySpan<byte> input, Span<char> output, Span<long> byteOffsets, bool isFinalBlock, CancellationToken cancellationToken);
    Xemele.XmlDiagnostic? ValidateDeclaration(ReadOnlySpan<char> encodingName, Xemele.XmlLocation location);
}
internal sealed class XmlInputDecoder : IXmlInputDecoder
{
    public XmlInputDecoder(Xemele.XmlParseOptions options, Uri? sourceUri = null) { }
    public XmlInputEncoding Encoding => throw new InvalidOperationException("Declaration model");
    public DecodeResult Decode(ReadOnlySpan<byte> input, Span<char> output, Span<long> byteOffsets, bool isFinalBlock, CancellationToken cancellationToken) => throw new InvalidOperationException("Declaration model");
    public Xemele.XmlDiagnostic? ValidateDeclaration(ReadOnlySpan<char> encodingName, Xemele.XmlLocation location) => throw new InvalidOperationException("Declaration model");
    public void Dispose() { }
}
