using Xemele;
if (Environment.Version.ToString() != "10.0.11") throw new Exception("Wrong actual runtime: " + Environment.Version);
var document = XmlDocument.Parse("<root><child id='x'>value</child></root>");
if (document.RootElement.LocalName != "root") throw new Exception("Earlier DOM regression");
var clone = new XmlDocument();
clone.DocumentNode.AppendChild(clone.ImportNode(document.RootElement));
if (clone.RootElement.Children.Count != 1) throw new Exception("Earlier import regression");
Console.WriteLine("PASS: Catalog independently compiled; actual runtime " + Environment.Version + "; verified prior DOM/import APIs executed");
static void CompileUsage(XmlCatalog catalog, XmlResourceResolver resolver, CancellationToken token)
{
    var request = new XmlResourceRequest(new Uri("https://example.test/entity"), null, XmlResourceKind.ExternalEntity) { SystemId = "entity", PublicId = "-//EXAMPLE//DTD TEST//EN" };
    Uri? mapped = catalog.Resolve(request, token);
    XmlResourceResolver composed = new CatalogResolver(catalog, resolver);
    ValueTask<XmlResolvedResource?> resource = composed.ResolveAsync(request, token);
    _ = XmlCatalog.Parse("<catalog xmlns='urn:oasis:names:tc:entity:xmlns:xml:catalog'/>", new() { BaseUri = request.Uri, Resolver = resolver }, token);
}
