<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <RuntimeFrameworkVersion>10.0.11</RuntimeFrameworkVersion>
    <TrimmerSingleWarn>false</TrimmerSingleWarn><ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="Xemele" Version="0.9.0-rc.1" /></ItemGroup>
  <Target Name="PinnedLocalLinkerHost" BeforeTargets="_RunILLink" Condition="'$(PinnedLinkerHost)' != '' and '$(RunILLink)' != 'false'">
    <PropertyGroup><_DotNetHostDirectory>$(PinnedLinkerHost)</_DotNetHostDirectory><_DotNetHostFileName Condition="'$(PinnedLinkerHostName)' == ''">dotnet</_DotNetHostFileName><_DotNetHostFileName Condition="'$(PinnedLinkerHostName)' != ''">$(PinnedLinkerHostName)</_DotNetHostFileName></PropertyGroup>
  </Target>
</Project>
