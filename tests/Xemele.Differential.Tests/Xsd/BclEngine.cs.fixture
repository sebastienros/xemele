using System.Net;
using System.Text.Json;
using System.Xml;
using System.Xml.Schema;
namespace XsdCorpus;
internal static class BclEngine
{
    internal sealed class Resolver : XmlResolver
    {
        internal readonly List<object> Requests = [];
        public override ICredentials? Credentials { set { } }
        public override object GetEntity(Uri uri, string? role, Type? type)
        { Requests.Add(new { resolution = Runner.AuthoredUnavailable(uri) ? "authored-unavailable" : "pinned-input", uri = uri.AbsoluteUri, role }); if (Runner.AuthoredUnavailable(uri)) throw new FileNotFoundException("Authored unavailable resource: " + uri); return File.OpenRead(Runner.PathFor(uri)); }
    }
    internal static string ExceptionOutcome(Exception e, bool schema)
    {
        if (e is XmlException && (e.Message.Contains("MaxCharacters", StringComparison.Ordinal) || e.Message.Contains("DTD is prohibited", StringComparison.Ordinal) || e.Message.Contains("Version number '1.1' is invalid", StringComparison.Ordinal))) return "reference-policy-refusal";
        return e is XmlSchemaException ? (schema ? "schema-invalid" : "instance-invalid") : e is XmlException ? (schema ? "schema-invalid" : "instance-syntax-error") : "harness-exception";
    }
    internal static bool ReadAssessment(XmlReader reader)
    {
        bool assessed = false;
        while (reader.Read())
            if (reader.Depth == 0 && reader.NodeType is XmlNodeType.Element or XmlNodeType.EndElement)
                assessed |= reader.SchemaInfo?.SchemaElement is not null || reader.SchemaInfo?.SchemaType is not null;
        return assessed;
    }
    internal static Observation ProbeHintSchema(Runner.HintSchemaPreparationException failure, Resolver resolver)
    {
        var errors = new List<string>(); var warnings = new List<string>(); Observation probe;
        try
        {
            var source = Runner.UriFor(failure.Input.Location); using var stream = File.OpenRead(Runner.PathFor(source));
            var schemas = new XmlSchemaSet { XmlResolver = resolver };
            schemas.ValidationEventHandler += (_, e) => { if (e.Severity == XmlSeverityType.Error) errors.Add(e.Message); else warnings.Add(e.Message); };
            using var reader = XmlReader.Create(stream, new XmlReaderSettings { DtdProcessing = DtdProcessing.Prohibit, XmlResolver = resolver, MaxCharactersInDocument = 67_108_864 }, source.AbsoluteUri);
            schemas.Add(null, reader); schemas.Compile();
            probe = new(errors.Count > 0 ? "schema-invalid" : "schema-valid", string.Join("; ", errors.Concat(warnings.Select(w => "warning: " + w))), [], resolver.Requests.ToArray());
        }
        catch (Exception e) { probe = new(ExceptionOutcome(e, schema: true), e.GetType().Name + ": " + e.Message, [], resolver.Requests.ToArray()); }
        return probe with { Outcome = probe.Outcome == "schema-invalid" ? "schema-unavailable" : probe.Outcome == "schema-valid" ? "instance-hint-preparation-limitation" : probe.Outcome,
            Detail = "Hint namespace preparation failed: " + failure.Message + "; unchanged original schema probe: " + probe.Outcome + ": " + probe.Detail + "; instance assessment not executed" };
    }
    internal static void Run(JsonElement group, StreamWriter output)
    {
        var row = group.GetProperty("schema"); var resolver = new Resolver(); var schemas = new XmlSchemaSet { XmlResolver = resolver };
        var errors = new List<string>(); var warnings = new List<string>(); schemas.ValidationEventHandler += (_, e) => { if (e.Severity == XmlSeverityType.Error) errors.Add(e.Message); else warnings.Add(e.Message); };
        Observation compile;
        try
        {
            var input = Runner.Input(row.ValueKind == JsonValueKind.Null ? [] : Runner.Documents(row)); using var stream = input.Input;
            using var reader = XmlReader.Create(stream, new XmlReaderSettings { DtdProcessing = DtdProcessing.Prohibit, XmlResolver = resolver, CloseInput = false, MaxCharactersInDocument = 67_108_864 }, input.Source.AbsoluteUri);
            schemas.Add(null, reader); schemas.Compile();
            compile = new(errors.Count > 0 ? "schema-invalid" : "schema-valid", string.Join("; ", errors.Concat(warnings.Select(w => "warning: " + w))), [], resolver.Requests.ToArray());
        }
        catch (Exception e) { compile = new(ExceptionOutcome(e, schema: true), e.GetType().Name + ": " + e.Message, [], resolver.Requests.ToArray()); }
        if (row.ValueKind != JsonValueKind.Null) Runner.Emit(row, compile, "bcl", output);
        foreach (var instance in Runner.Instances(group))
        {
            if (instance.GetProperty("classification").GetString() != "applicable") { Runner.Emit(instance, new("excluded", instance.GetProperty("reason").GetString()!, [], []), "bcl", output); continue; }
            Observation actual;
            if (compile.Outcome != "schema-valid") actual = new("schema-unavailable", compile.Detail, [], compile.Resources);
            else
            {
                var instanceErrors = new List<string>(); var instanceWarnings = new List<string>();
                var instanceResolver = new Resolver(); var preparation = new List<object>();
                try
                {
                    string path = Runner.PathFor(Runner.UriFor(Runner.Documents(instance).Single()));
                    var originals = row.ValueKind == JsonValueKind.Null ? Array.Empty<string>() : Runner.Documents(row);
                    var plan = Runner.InstanceInputs(instance, originals, preparation); var validationSchemas = schemas;
                    if (plan.Augmented)
                    {
                        validationSchemas = new XmlSchemaSet { XmlResolver = instanceResolver };
                        validationSchemas.ValidationEventHandler += (_, e) => { if (e.Severity == XmlSeverityType.Error) instanceErrors.Add(e.Message); else instanceWarnings.Add(e.Message); };
                        var prepared = Runner.InstanceInput(plan); using var preparedStream = prepared.Input;
                        using var preparedReader = XmlReader.Create(preparedStream, new XmlReaderSettings { DtdProcessing = DtdProcessing.Prohibit, XmlResolver = instanceResolver, MaxCharactersInDocument = 67_108_864 }, prepared.Source.AbsoluteUri);
                        validationSchemas.Add(null, preparedReader); validationSchemas.Compile();
                        if (instanceErrors.Count > 0)
                        {
                            Runner.Emit(instance, new("schema-unavailable", string.Join("; ", instanceErrors.Concat(instanceWarnings.Select(w => "warning: " + w))), [], [.. preparation, .. instanceResolver.Requests]), "bcl", output); continue;
                        }
                    }
                    var settings = new XmlReaderSettings { Schemas = validationSchemas, ValidationType = ValidationType.Schema, DtdProcessing = DtdProcessing.Prohibit, XmlResolver = null, MaxCharactersInDocument = 67_108_864 };
                    settings.ValidationFlags = XmlSchemaValidationFlags.ProcessIdentityConstraints | XmlSchemaValidationFlags.AllowXmlAttributes | XmlSchemaValidationFlags.ReportValidationWarnings;
                    settings.ValidationEventHandler += (_, e) => { if (e.Severity == XmlSeverityType.Error) instanceErrors.Add(e.Message); else instanceWarnings.Add(e.Message); };
                    using var stream = File.OpenRead(path); using var reader = XmlReader.Create(stream, settings, Runner.UriFor(Runner.Documents(instance).Single()).AbsoluteUri);
                    bool assessed = ReadAssessment(reader);
                    actual = new(instanceErrors.Count > 0 ? "instance-invalid" : !assessed ? "instance-unassessed" : "instance-valid", string.Join("; ", instanceErrors.Concat(instanceWarnings.Select(w => "warning: " + w))), [], [.. preparation, .. instanceResolver.Requests]);
                    if (plan.Limitations.Length > 0) actual = actual with { Outcome = "instance-hint-ordering-limitation", Detail = string.Join("; ", plan.Limitations) + "; supplemental engine result: " + actual.Outcome + ": " + actual.Detail };
                }
                catch (Exception e) { actual = e is Runner.HintSchemaPreparationException hintFailure ? ProbeHintSchema(hintFailure, instanceResolver) : new(e is Runner.HintNamespaceException ? "instance-hint-namespace-mismatch" : e is XmlSchemaException and not XmlSchemaValidationException ? "schema-unavailable" : ExceptionOutcome(e, schema: false), e.GetType().Name + ": " + e.Message, [], instanceResolver.Requests.ToArray()); actual = actual with { Resources = [.. preparation, .. actual.Resources] }; }
            }
            Runner.Emit(instance, actual, "bcl", output);
        }
    }
}
