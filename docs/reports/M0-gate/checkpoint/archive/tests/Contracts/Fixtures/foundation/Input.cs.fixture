namespace FoundationModels;
internal enum ScanStep { NeedInput, Paused, Completed }
internal readonly record struct ScanResult(int Consumed, ScanStep Step);
internal interface ICharacterSink { bool Fragment(ReadOnlySpan<char> fragment, bool tokenEnded); }
// One-unit synthetic pump demonstrates consumption/borrow/pause/error contract only.
internal sealed class Pump
{
    private bool busy, completed, faulted;
    private bool eofPending;
    public ScanResult Append<TSink>(ReadOnlySpan<char> input, bool final, TSink sink, CancellationToken cancellationToken)
        where TSink : class, ICharacterSink
    {
        if (busy || completed || faulted) throw new InvalidOperationException("Invalid scanner state.");
        busy = true;
        try
        {
            cancellationToken.ThrowIfCancellationRequested();
            if (eofPending && input.Length != 0) throw new ArgumentException("Only empty EOF resume allowed.");
            for (int i = 0; i < input.Length; i++)
            {
                cancellationToken.ThrowIfCancellationRequested();
                if (!sink.Fragment(input.Slice(i, 1), false)) return new(i + 1, ScanStep.Paused);
            }
            if (!final) return new(input.Length, ScanStep.NeedInput);
            if (!eofPending)
            {
                cancellationToken.ThrowIfCancellationRequested();
                eofPending = true;
                if (!sink.Fragment([], true)) return new(input.Length, ScanStep.Paused);
            }
            completed = true; return new(input.Length, ScanStep.Completed);
        }
        catch { faulted = true; throw; }
        finally { busy = false; }
    }
}
