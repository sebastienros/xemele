// Contract-only executable models. Not referenced by the runtime or packaged.
using System.Collections.ObjectModel;
namespace Xemele;
public enum XmlDiagnosticSeverity { Warning, Error, Fatal }
public readonly record struct XmlLocation(Uri? SourceUri, int LineNumber, int LinePosition, long? ByteOffset);
public sealed record XmlDiagnostic(string Code, XmlDiagnosticSeverity Severity, string Message, XmlLocation Location);
public sealed class XmlParseException : Exception
{
    public IReadOnlyList<XmlDiagnostic> Diagnostics { get; }
    public XmlParseException(IEnumerable<XmlDiagnostic> diagnostics) : base("XML parsing failed.")
    {
        ArgumentNullException.ThrowIfNull(diagnostics);
        Diagnostics = Array.AsReadOnly(diagnostics.ToArray());
        if (Diagnostics.Count == 0) throw new ArgumentException("A parse exception requires diagnostics.", nameof(diagnostics));
    }
}
public sealed record XmlResourceLimits
{
    public long? DocumentCharacters { get; init; } = 16_777_216;
    public int? Depth { get; init; } = 256;
    public int? AttributesPerElement { get; init; } = 256;
    public int? TokenCharacters { get; init; } = 1_048_576;
    public int? InternedNames { get; init; } = 65_536;
    public int? EntityDepth { get; init; } = 32;
    public long? ExpandedCharacters { get; init; } = 16_777_216;
    public long? ExternalBytes { get; init; } = 16_777_216;
    public int? ExternalResources { get; init; } = 64;
    public int? InclusionDepth { get; init; } = 32;
    public int? Diagnostics { get; init; } = 128;
    public long? EvaluationWork { get; init; } = 10_000_000;
    public void Validate()
    {
        long?[] limits = [DocumentCharacters, Depth, AttributesPerElement, TokenCharacters, InternedNames,
            EntityDepth, ExpandedCharacters, ExternalBytes, ExternalResources, InclusionDepth, Diagnostics, EvaluationWork];
        if (limits.Any(n => n is <= 0)) throw new ArgumentOutOfRangeException(nameof(XmlResourceLimits));
    }
}
public sealed record XmlParseOptions
{
    public XmlResourceLimits Limits { get; init; } = new();
#if M2
    public bool Recover { get; init; }
    public XmlDtdProcessing DtdProcessing { get; init; } = XmlDtdProcessing.Prohibit;
    public XmlResourceResolver? Resolver { get; init; }
#endif
}
public sealed record XmlParseResult<T> where T : class
{
    public T? Value { get; }
    public bool IsComplete { get; }
    public bool IsWellFormed { get; }
    public IReadOnlyList<XmlDiagnostic> Diagnostics { get; }
    public XmlParseResult(T? value, bool isComplete, bool isWellFormed, IEnumerable<XmlDiagnostic> diagnostics)
    {
        ArgumentNullException.ThrowIfNull(diagnostics);
        if (isWellFormed && (!isComplete || value is null)) throw new ArgumentException("Well-formed results require a complete value.");
        Value = value; IsComplete = isComplete; IsWellFormed = isWellFormed;
        Diagnostics = Array.AsReadOnly(diagnostics.ToArray());
    }
}
#if M2
public enum XmlDtdProcessing { Prohibit, Parse }
public enum XmlResourceKind { ExternalSubset, ExternalEntity }
public sealed record XmlResourceRequest(Uri Uri, Uri? Referrer, XmlResourceKind Kind);
public abstract class XmlResourceResolver
{
    public abstract XmlResolvedResource? Resolve(XmlResourceRequest request, CancellationToken cancellationToken);
    public virtual ValueTask<XmlResolvedResource?> ResolveAsync(XmlResourceRequest request, CancellationToken cancellationToken)
        => ValueTask.FromResult(Resolve(request, cancellationToken));
}
public sealed class XmlResolvedResource : IDisposable, IAsyncDisposable
{
    private bool disposed;
    public Stream Content { get; }
    public Uri SourceUri { get; }
    public XmlResolvedResource(Stream content, Uri sourceUri)
    {
        ArgumentNullException.ThrowIfNull(content); ArgumentNullException.ThrowIfNull(sourceUri);
        if (!content.CanRead || !sourceUri.IsAbsoluteUri) throw new ArgumentException("Readable stream and absolute URI required.");
        Content = content; SourceUri = sourceUri;
    }
    public void Dispose() { if (!disposed) { disposed = true; Content.Dispose(); } }
    public async ValueTask DisposeAsync() { if (!disposed) { disposed = true; await Content.DisposeAsync(); } }
}
#endif
