* text=auto

# Keep hash-pinned corpora, encoding vectors, and canonicalization data byte-exact.
tests/corpora/** -text
tests/fixtures/** -text

# Preserve binary/encoded fuzzing seeds and frozen benchmark payloads.
tests/Fuzz/seeds/** -text
benchmarks/baselines/release/fixtures/** -text

# Contract data includes original XML inputs and a SHA-256-pinned grammar.
tests/Contracts/Fixtures/**/*.xml -text
tests/Contracts/Fixtures/**/*.rnc -text

# Frozen reference runner source hashes are verified before compilation.
tools/ReferenceRunners/RelaxNg/RngReference.java -text
tools/ReferenceRunners/RelaxNg/libxml2_reference.c -text
